# Chave do provedor LLM usado pelos adapters e pelo juiz estruturado.
OPENAI_API_KEY=

# Modelo padrão (ajuste conforme o provedor).
OPENAI_MODEL=gpt-4.1-mini

# Limiar mínimo do avaliador híbrido (0–1) para aceitar uma versão.
EVAL_PASS_THRESHOLD=0.7

# Máximo de iterações do reflection loop.
EVAL_MAX_RETRIES=2

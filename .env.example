# OpenRouter (geracao dos adapters). Nunca commitar a chave real.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Jev / TypeSafe AI (decisoes tipadas no avaliador). No escopo.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Limiar do avaliador hibrido (0-1) e retries do reflection loop.
EVAL_PASS_THRESHOLD=0.7
EVAL_MAX_RETRIES=2
